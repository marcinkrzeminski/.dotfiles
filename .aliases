###############################################################################
# DIRECTORIES
###############################################################################

alias s='cd ~/Sites'
alias d='cd ~/Desktop'
alias dl='cd ~/Downloads'
alias v='cd /Volumes'

###############################################################################
# MISC
###############################################################################

alias h='sudo $EDITOR /etc/hosts'

alias zs='$EDITOR ~/.zshrc'
alias dt='$EDITOR ~/.dotfiles'
alias src='source ~/.zshrc'

alias cat='bat'
alias o='open .'
alias c='clear'
alias c.='code .'
alias z.='zed .'

alias pip=pip3

# Get macOS Software Updates, and update installed Ruby gems, Homebrew, npm, and their installed packages
alias update='brew update; brew upgrade; brew cleanup; sudo gem update --system; sudo gem update; sudo gem cleanup'

alias crawler='java --add-exports java.desktop/com.apple.eawt=ALL-UNNAMED -jar ~/apps/buu.jar'

###############################################################################
# Git
###############################################################################

alias gs='git status'
alias gf='git fetch --all'

# Merge master into current
alias gmc='git checkout master && git pull && git checkout - && git merge master'

# Get latest changes and apply them
alias gla='git fetch --all && git reset --hard origin/master'

# Amend message for commit that's already pushed
alias gaf='git commit --amend --no-edit && git push origin master --force'

# Switch to master || main branch
alias master="git checkout main 2>/dev/null || git checkout master"
alias main="git checkout main 2>/dev/null || git checkout master"

# Undo git push
alias gup="git push -f origin HEAD^:master"

# Show files that assumed-unchanged
alias gun="git ls-files -v | grep '^[[:lower:]]'"

alias pull="git pull"

alias push="git push origin HEAD"

###############################################################################
# package managers
###############################################################################

alias nri='pnpm install'
alias nrd='pnpm dev'
alias nrb='pnpm build'
alias nrs='pnpm start'
alias nrsa='pnpm stop-all'
alias nrcd='npm run clean-dev'
alias nrcb='npm run clean-build'

###############################################################################
# Valet
###############################################################################

alias vstop='valet stop && valet stop dnsmasq && brew services stop mariadb '
alias vstart='valet start && brew services start mariadb'

###############################################################################
# Better ls
###############################################################################

alias l='eza -lah --group-directories-first --octal-permissions --icons'
alias ls='eza --group-directories-first --icons'
alias sl='eza --group-directories-first --icons'

###############################################################################
# Safe rm
###############################################################################

alias rm=trash

###############################################################################
# Claude Code & Friends
###############################################################################

alias ccusage='bunx ccusage'
alias cc='claude'
alias ccc='claude --continue'
alias colo='claude --dangerously-skip-permissions'
alias golo='claude --dangerously-skip-permissions --settings ~/.claude/settings.glm.json --model glm-5.1'
alias glm='claude --settings ~/.claude/settings.glm.json --model glm-5.1'
alias oc='opencode'
